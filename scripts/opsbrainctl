#!/usr/bin/env bash
# opsbrainctl — install, check, upgrade, back up, restore and remove AI-OpsBrain platform modules.
# Run `opsbrainctl help` for usage.
set -Eeuo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
OPSBRAIN_HOME=${OPSBRAIN_HOME:-$(cd "$(dirname "$SELF")/.." && pwd)}
export OPSBRAIN_HOME

# shellcheck source=lib/common.sh
. "$OPSBRAIN_HOME/scripts/lib/common.sh"
# shellcheck source=lib/tls.sh
. "$OPSBRAIN_HOME/scripts/lib/tls.sh"
# shellcheck source=lib/core.sh
. "$OPSBRAIN_HOME/scripts/lib/core.sh"
# shellcheck source=lib/backup.sh
. "$OPSBRAIN_HOME/scripts/lib/backup.sh"

usage() {
  cat <<EOF
opsbrainctl $(version) — manage the AI-OpsBrain platform server

Usage: sudo opsbrainctl <command> [module] [options]

Modules: ${ALL_MODULES[*]}   (available in this release: ${AVAILABLE_MODULES[*]})

Commands:
  install <module>        Install and start a module.
      core options: --hostname NAME      Name users type in the browser (default: this host's FQDN)
                    --extra-names "A B"  More DNS names / IPs for the certificate (default: this host's IPs)
                    --http-port N --https-port N
                    --admin-user U --admin-email E --admin-password-file F   (non-interactive first admin)
  status [module]         Show module, service, certificate, backup and disk health. Exit code 1 if unhealthy.
  upgrade [module]        Back up, rebuild and restart with the code in $OPSBRAIN_HOME.
      options: --ref GIT_REF   check out a tag/branch first     --skip-backup (asks to confirm)
  backup                  Take an encrypted backup now.
      options: --list   --check   --tag NAME   --quiet
  restore [SNAPSHOT]      Restore the platform database from a backup (default: latest).
      options: --include-config   --no-safety-backup
  remove <module>         Stop and remove a module. Data is KEPT.
      options: --purge          Also delete the module's data (asks you to type a confirmation phrase)
               --purge-backups  With --purge on core: delete backups too (second confirmation)
               --no-final-backup
  cert show|renew|import  Server certificate. renew [--if-expiring DAYS]   import --cert FILE --key FILE
  admin create            Create an administrator from the server console (account recovery).
  restart [service...]    Recreate core services (picks up edited configuration files).
  verify-audit            Verify the audit log hash chain.
  logs <service> [-f]     Show logs of a core service (web, api, worker, postgres, valkey, migrate).
  version                 Print the version.

Global options: --yes (answer yes to y/N questions; never bypasses typed confirmations)
EOF
}

parse_common_opts() {
  REST=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes | -y) ASSUME_YES=1 ;;
      --hostname) OPSBRAIN_HOSTNAME=$2; shift ;;
      --extra-names) OPSBRAIN_EXTRA_NAMES=$2; shift ;;
      --http-port) OPSBRAIN_HTTP_PORT=$2; shift ;;
      --https-port) OPSBRAIN_HTTPS_PORT=$2; shift ;;
      --admin-user) ADMIN_USER=$2; shift ;;
      --admin-email) ADMIN_EMAIL=$2; shift ;;
      --admin-password-file) ADMIN_PASSWORD_FILE=$2; shift ;;
      --ref) UPGRADE_REF=$2; shift ;;
      --skip-backup) SKIP_BACKUP=1 ;;
      --list) BACKUP_LIST=1 ;;
      --check) BACKUP_CHECK=1 ;;
      --tag) BACKUP_TAG=$2; shift ;;
      --quiet | -q) QUIET=1 ;;
      --include-config) RESTORE_CONFIG=1 ;;
      --no-safety-backup) NO_SAFETY_BACKUP=1 ;;
      --purge) PURGE=1 ;;
      --purge-backups) PURGE_BACKUPS=1 ;;
      --no-final-backup) NO_FINAL_BACKUP=1 ;;
      --if-expiring) IF_EXPIRING=$2; shift ;;
      --cert) CERT_FILE=$2; shift ;;
      --key) KEY_FILE=$2; shift ;;
      -f | --follow) FOLLOW=1 ;;
      -h | --help) usage; exit 0 ;;
      -*) die "Unknown option: $1" ;;
      *) REST+=("$1") ;;
    esac
    shift
  done
}

module_not_available() {
  die "Module '$1' is not available in AI-OpsBrain $(version) yet. Available: ${AVAILABLE_MODULES[*]}"
}

cmd_cert() {
  local sub=${1:-show}
  case "$sub" in
    show) tls_show ;;
    renew)
      require_root cert
      OPSBRAIN_HOSTNAME=$(env_get "$OPSBRAIN_ETC/compose.env" OPSBRAIN_HOSTNAME)
      OPSBRAIN_EXTRA_NAMES=$(env_get "$OPSBRAIN_ETC/compose.env" OPSBRAIN_EXTRA_NAMES)
      if [[ -n ${IF_EXPIRING:-} ]] && (($(tls_days_left) > IF_EXPIRING)); then
        [[ ${QUIET:-0} == 1 ]] || ok "Certificate valid for $(tls_days_left) more days; nothing to do."
        return 0
      fi
      if [[ $(cat "$OPSBRAIN_ETC/tls/source" 2>/dev/null) == imported ]]; then
        die "This server uses an imported certificate. Get a new one from your CA and run: opsbrainctl cert import"
      fi
      tls_issue_server
      module_installed core && compose core restart web >/dev/null && ok "Web proxy reloaded"
      ;;
    import)
      require_root cert
      [[ -n ${CERT_FILE:-} && -n ${KEY_FILE:-} ]] || die "Usage: opsbrainctl cert import --cert FULLCHAIN.pem --key KEY.pem"
      OPSBRAIN_HOSTNAME=$(env_get "$OPSBRAIN_ETC/compose.env" OPSBRAIN_HOSTNAME)
      tls_import "$CERT_FILE" "$KEY_FILE"
      module_installed core && compose core restart web >/dev/null && ok "Web proxy reloaded"
      ;;
    *) die "Usage: opsbrainctl cert show|renew|import" ;;
  esac
}

main() {
  [[ $# -gt 0 ]] || {
    usage
    exit 0
  }
  local cmd=$1
  shift
  parse_common_opts "$@"
  set -- "${REST[@]+"${REST[@]}"}"
  case "$cmd" in
    help | -h | --help) usage ;;
    version | --version) version ;;
    install)
      local m=${1:-}
      [[ -n $m ]] || die "Usage: opsbrainctl install <module>"
      check_module_name "$m"
      case "$m" in
        core) cmd_install_core ;;
        *) module_not_available "$m" ;;
      esac
      ;;
    status)
      [[ -z ${1:-} ]] || check_module_name "$1"
      cmd_status "${1:-}"
      ;;
    upgrade)
      local m=${1:-core}
      check_module_name "$m"
      [[ $m == core ]] || module_not_available "$m"
      cmd_upgrade_core
      ;;
    backup) cmd_backup ;;
    restore)
      RESTORE_SNAPSHOT=${1:-latest}
      cmd_restore
      ;;
    remove | uninstall)
      local m=${1:-}
      [[ -n $m ]] || die "Usage: opsbrainctl remove <module> [--purge]"
      check_module_name "$m"
      case "$m" in
        core) cmd_remove_core ;;
        *) module_installed "$m" || die "Module '$m' is not installed." ;;
      esac
      ;;
    cert) cmd_cert "${1:-show}" ;;
    admin)
      [[ ${1:-} == create ]] || die "Usage: opsbrainctl admin create [--admin-user U --admin-email E]"
      require_root admin
      module_installed core || die "Core is not installed."
      # Account recovery path: allowed even when users exist.
      local user=${ADMIN_USER:-} email=${ADMIN_EMAIL:-} pw pw2
      [[ -n $user ]] || read -r -p "Username: " user
      [[ -n $email ]] || read -r -p "Email: " email
      read -r -s -p "Password: " pw
      echo
      read -r -s -p "Repeat password: " pw2
      echo
      [[ $pw == "$pw2" ]] || die "Passwords do not match."
      printf '%s\n' "$pw" | compose core exec -T api opsbrain-admin create-admin --username "$user" --email "$email"
      ;;
    restart)
      require_root restart
      module_installed core || die "Core is not installed."
      # Recreate (not just restart) so changed env files and certificates are picked up.
      compose core up -d --force-recreate "${@}"
      wait_healthy core 240 || die "Not healthy after restart; see opsbrainctl logs <service>"
      ok "Restarted ${*:-all core services}"
      ;;
    verify-audit)
      require_root verify-audit
      compose core exec -T api opsbrain-admin verify-audit
      ;;
    logs)
      local svc=${1:-}
      [[ -n $svc ]] || die "Usage: opsbrainctl logs <service> [-f]"
      if [[ ${FOLLOW:-0} == 1 ]]; then compose core logs -f --tail 200 "$svc"; else compose core logs --tail 300 "$svc"; fi
      ;;
    *) die "Unknown command '$cmd'. Run: opsbrainctl help" ;;
  esac
}

main "$@"
