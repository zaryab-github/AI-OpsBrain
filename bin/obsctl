#!/usr/bin/env bash
# obsctl - operate the AI Centralized Observability Platform.
#
#   obsctl <module> <command> [options]      e.g. obsctl core status
#   obsctl status | doctor | version
#
# Modules available in this release: core
set -Eeuo pipefail

# Resolve the real location of this script (it may be symlinked into /usr/local/bin).
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="${dir}/${src}"
done
OBS_CTL="$(cd -P "$(dirname "$src")" && pwd)/$(basename "$src")"
OBS_ROOT="$(cd -P "$(dirname "$src")/.." && pwd)"
export OBS_CTL OBS_ROOT

# shellcheck source=lib/common.sh
source "${OBS_ROOT}/lib/common.sh"
# shellcheck source=lib/docker.sh
source "${OBS_ROOT}/lib/docker.sh"
trap obs_cleanup EXIT

AVAILABLE_MODULES=(core)

usage() {
  cat <<'USAGE'
Usage: obsctl [-y] <module> <command> [options]
       obsctl status | doctor | version | help

Modules (this release): core
Commands every module supports: install status upgrade backup restore remove

Examples:
  sudo obsctl core install --hostname obs.example.internal
  obsctl core status
  sudo obsctl core backup
  sudo obsctl core remove            # keeps data
  sudo obsctl core remove --purge    # asks for confirmation first

Run `obsctl <module> --help` for the full command list.
USAGE
}

load_module() {
  local m
  for m in "${AVAILABLE_MODULES[@]}"; do
    if [[ "$m" == "$1" ]]; then
      # shellcheck source=/dev/null
      source "${OBS_ROOT}/lib/modules/${m}.sh"
      return 0
    fi
  done
  return 1
}

cmd_status_all() {
  local m rc=0
  for m in "${AVAILABLE_MODULES[@]}"; do
    load_module "$m"
    "${m}_status" || rc=$?
  done
  return "$rc"
}

cmd_doctor() {
  load_module core
  log_info "checking host requirements"
  if core_preflight "$(env_get "$MOD_ENV_FILE" OBS_HTTP_PORT 80)" "$(env_get "$MOD_ENV_FILE" OBS_HTTPS_PORT 443)"; then
    log_info "all checks passed"
  else
    # ports in use are expected once core runs; only fail when it is not installed
    if core_installed; then log_warn "some checks reported problems (ports in use is normal while core runs)"; else exit 1; fi
  fi
}

main() {
  while (( $# )); do
    case "$1" in
      -y|--yes) OBS_ASSUME_YES=1; export OBS_ASSUME_YES; shift ;;
      *) break ;;
    esac
  done
  local first="${1:-}"
  [[ $# -gt 0 ]] && shift
  case "$first" in
    ""|-h|--help|help) usage ;;
    version|--version) printf 'obsctl %s\n' "$(tr -d '[:space:]' < "${OBS_ROOT}/VERSION")" ;;
    status) cmd_status_all ;;
    doctor) cmd_doctor ;;
    *)
      if load_module "$first"; then
        "${first}_main" "$@"
      else
        die "unknown module or command: ${first}. Modules available in this release: ${AVAILABLE_MODULES[*]}"
      fi
      ;;
  esac
}

main "$@"
